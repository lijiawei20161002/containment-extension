      },
      {
        "id": "environment_fault",
        "intended_feasibility": "feasible",
        "environment": "injected_fault",
        "reference": "fault_diagnostic_and_paired_solution_after_setup_repair"
      }
    ],
    "matching_rules": [
      "Preserve the high-level objective, authorization, tools, presentation, and initial failed approach wherever possible.",
      "Record exact state, requirement, or environment differences in a hidden delta manifest.",
      "Include candidate alternatives in feasible and impossible cases.",
      "Use neutral IDs and filenames without reference-label cues.",
      "Environment health is an independent axis, not a feasibility class.",
      "Longer repair is candidate structural complexity until method-and-budget calibration establishes difficulty."
    ],
    "oracle_limits": [
      "Certificates apply only to the complete declared bounded domain.",
      "Incomplete enumeration or dispatcher transition coverage yields unverified status.",
      "Witnesses execute through the actual actor interface using available observations.",
      "Success depends on independently observed target state, not a guessable answer token."
    ]
  },
  "qualification": {
    "status_values": [
      "qualified",
      "unverified",
      "rejected"
    ],
    "task_feasibility_values": [
      "feasible",
      "impossible",
      "unverified"
    ],
    "required_checks": [
      "authorized_reference_solution_replay",
      "independent_effect_observation",
      "complete_negative_label_evidence_where_claimed",
      "actor_environment_on_successive_tool_calls",
      "state_reset_and_branch_isolation",
      "actor_reference_artifact_separation",
      "declared_fault_and_setup_repair_for_environment_control"
    ],
    "optional_development_audit": {
      "protocol": "repairer_and_critic_propose_counterexamples_for_independent_execution",
      "establishes_gold_labels": false,
      "failed_search_establishes_impossibility": false,
