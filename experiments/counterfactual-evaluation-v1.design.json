  "first_family": {
    "domain": "bounded_local_workflow",
    "objective": "Reach an observed target state through documented authorized operations.",
    "initial_observation": "A common direct attempt fails.",
    "oracle": "Independent finite graph reachability, validated against every declared dispatcher transition.",
    "variants": [
      {
        "id": "short_repair",
        "intended_feasibility": "feasible",
        "environment": "healthy",
        "reference": "authorized_short_solution_trace"
      },
      {
        "id": "longer_repair",
        "intended_feasibility": "feasible",
        "environment": "healthy",
        "reference": "authorized_multi_prerequisite_solution_trace"
      },
